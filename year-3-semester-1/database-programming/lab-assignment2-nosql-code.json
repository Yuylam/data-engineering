// Question B1
db.appointments
    .find(
        {status: "COMPLETED", fee: {$gt: 100, $lt: 300}}, 
        {appointmentId: 1, patientName: 1, department: 1, fee: 1})
    .sort({department: 1, fee: -1})

// Question B2
db.appointments.aggregate([
    {$group: {
        _id: "$department", 
        totalAppointments: {$sum: 1}, 
        totalFees: {$sum: "$fee"}}},
    {$sort: {totalFees: -1}}
])

